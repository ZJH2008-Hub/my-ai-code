:root {
  color-scheme: dark;
  --ink: #f4eee7;
  --muted: #968f89;
  --muted-strong: #c9c0b8;
  --coral: #ff765f;
  --rose: #ff5f91;
  --mint: #99e1c6;
  --line: rgba(255, 246, 237, 0.14);
  --line-strong: rgba(255, 246, 237, 0.24);
  --glass: rgba(12, 17, 20, 0.56);
  --bloom: 0.78;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --serif: "Iowan Old Style", "Baskerville", "Times New Roman", "Songti SC", "STSong", serif;
  --sans: "Avenir Next", "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  min-width: 320px;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: #06090c;
}

body {
  color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
  font: inherit;
}

.app-shell {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 560px;
  isolation: isolate;
  overflow: hidden;
  background:
    radial-gradient(ellipse 48% 64% at 74% 44%, rgba(147, 34, 68, 0.19), transparent 66%),
    radial-gradient(ellipse 55% 60% at 49% 88%, rgba(17, 79, 79, 0.16), transparent 70%),
    linear-gradient(115deg, #05080b 0%, #091014 38%, #07100f 72%, #05080a 100%);
}

#webgl {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  outline: none;
  opacity: 0;
  transition: opacity 1.8s ease;
  touch-action: none;
}

body.is-ready #webgl {
  opacity: 1;
}

.atmosphere {
  position: absolute;
  inset: -20%;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(circle at 72% 48%, rgba(255, 106, 111, 0.1) 0, transparent 23%),
    radial-gradient(circle at 58% 45%, rgba(196, 57, 116, 0.09) 0, transparent 31%),
    conic-gradient(
      from 215deg at 67% 50%,
      transparent 0deg,
      rgba(44, 150, 135, 0.08) 32deg,
      transparent 70deg,
      rgba(255, 126, 91, 0.05) 130deg,
      transparent 190deg
    );
  filter: blur(12px);
  animation: atmosphere-drift 18s ease-in-out infinite alternate;
}

.atmosphere::before,
.atmosphere::after {
  position: absolute;
  content: "";
  border: 1px solid rgba(255, 255, 255, 0.035);
  border-radius: 50%;
}

.atmosphere::before {
  top: 12%;
  right: -8%;
  width: 72vw;
  aspect-ratio: 1;
}

.atmosphere::after {
  right: 5%;
  bottom: -28%;
  width: 52vw;
  aspect-ratio: 1;
}

.grain {
  position: absolute;
  inset: 0;
  z-index: 8;
  pointer-events: none;
  opacity: 0.14;
  mix-blend-mode: soft-light;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.46'/%3E%3C/svg%3E");
}

.topbar {
  position: relative;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 30px clamp(28px, 5vw, 78px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.075);
  animation: ui-enter 1.1s 0.25s var(--ease-out) both;
}

.brand {
  display: inline-flex;
  gap: 13px;
  align-items: center;
  color: var(--ink);
  text-decoration: none;
}

.brand-mark {
  position: relative;
  display: block;
  width: 30px;
  height: 30px;
  transform: rotate(10deg);
}

.brand-mark i {
  position: absolute;
  top: 3px;
  left: 12px;
  width: 7px;
  height: 14px;
  border: 1px solid rgba(255, 176, 161, 0.9);
  border-radius: 100% 0 100% 0;
  transform-origin: 50% 12px;
  filter: drop-shadow(0 0 5px rgba(255, 105, 112, 0.5));
}

.brand-mark i:nth-child(1) {
  transform: rotate(0deg);
}

.brand-mark i:nth-child(2) {
  transform: rotate(72deg);
}

.brand-mark i:nth-child(3) {
  transform: rotate(144deg);
}

.brand-mark i:nth-child(4) {
  transform: rotate(216deg);
}

.brand-mark b {
  position: absolute;
  top: 12px;
  left: 12px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--coral);
  box-shadow: 0 0 11px rgba(255, 118, 95, 0.9);
}

.brand-mark::after {
  position: absolute;
  top: 3px;
  left: 12px;
  width: 7px;
  height: 14px;
  content: "";
  border: 1px solid rgba(255, 176, 161, 0.9);
  border-radius: 100% 0 100% 0;
  transform: rotate(288deg);
  transform-origin: 50% 12px;
  filter: drop-shadow(0 0 5px rgba(255, 105, 112, 0.5));
}

.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.brand-copy strong {
  font-family: var(--serif);
  font-size: 20px;
  font-weight: 400;
  letter-spacing: 0.25em;
  line-height: 1;
}

.brand-copy small {
  color: var(--muted);
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 0.18em;
}

.topbar-meta {
  display: flex;
  gap: clamp(22px, 4vw, 58px);
  align-items: center;
}

.coordinate {
  color: rgba(230, 220, 210, 0.45);
  font-family: var(--serif);
  font-size: 10px;
  letter-spacing: 0.14em;
}

.live-status {
  display: flex;
  gap: 9px;
  align-items: center;
  color: var(--muted-strong);
  font-size: 10px;
  letter-spacing: 0.13em;
  white-space: nowrap;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #74706d;
  box-shadow: 0 0 0 4px rgba(116, 112, 109, 0.08);
  transition:
    background 0.4s ease,
    box-shadow 0.4s ease;
}

.live-status.is-camera .status-dot {
  background: var(--coral);
  box-shadow: 0 0 0 4px rgba(255, 118, 95, 0.09), 0 0 12px rgba(255, 118, 95, 0.7);
}

.live-status.is-tracking .status-dot {
  background: var(--mint);
  box-shadow: 0 0 0 4px rgba(153, 225, 198, 0.09), 0 0 12px rgba(153, 225, 198, 0.8);
  animation: status-pulse 1.8s ease-in-out infinite;
}

.interface {
  position: relative;
  z-index: 10;
  width: 100%;
  height: calc(100% - 91px);
  pointer-events: none;
}

.hero {
  position: absolute;
  top: 50%;
  left: clamp(28px, 7.3vw, 112px);
  width: min(500px, 38vw);
  transform: translateY(-50%);
  pointer-events: auto;
  animation: ui-enter 1.2s 0.45s var(--ease-out) both;
}

.eyebrow {
  display: flex;
  gap: 12px;
  align-items: center;
  margin: 0 0 27px;
  color: var(--muted-strong);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.18em;
}

.eyebrow span:first-child {
  display: grid;
  width: 25px;
  height: 25px;
  color: var(--coral);
  font-family: var(--serif);
  font-size: 10px;
  letter-spacing: 0;
  border: 1px solid rgba(255, 118, 95, 0.35);
  border-radius: 50%;
  place-items: center;
}

.eyebrow i {
  width: 46px;
  height: 1px;
  margin-left: 2px;
  background: linear-gradient(90deg, var(--line-strong), transparent);
}

.hero h1 {
  max-width: 520px;
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(58px, 5.5vw, 92px);
  font-weight: 400;
  letter-spacing: -0.065em;
  line-height: 0.99;
  text-wrap: balance;
  text-shadow: 0 0 42px rgba(0, 0, 0, 0.35);
}

.hero h1 em {
  position: relative;
  color: #ffb099;
  font-weight: 400;
  font-style: italic;
  text-shadow: 0 0 30px rgba(255, 112, 105, 0.16);
}

.hero h1 em::after {
  position: absolute;
  right: -23px;
  bottom: 10px;
  width: 7px;
  height: 7px;
  content: "";
  border-radius: 50%;
  background: var(--coral);
  box-shadow: 0 0 14px 2px rgba(255, 103, 91, 0.7);
}

.lede {
  max-width: 390px;
  margin: 26px 0 0;
  color: rgba(218, 209, 201, 0.62);
  font-family: var(--serif);
  font-size: 14px;
  letter-spacing: 0.035em;
  line-height: 1.95;
}

.gesture-guide {
  display: flex;
  align-items: center;
  gap: 22px;
  margin-top: 34px;
}

.gesture-item {
  display: flex;
  gap: 12px;
  align-items: center;
}

.gesture-icon {
  position: relative;
  display: block;
  flex: 0 0 auto;
  width: 42px;
  height: 42px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.025);
}

.gesture-item > span:last-child {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.gesture-item b {
  color: rgba(245, 237, 230, 0.9);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.21em;
}

.gesture-item small {
  color: rgba(203, 194, 186, 0.42);
  font-size: 9px;
  letter-spacing: 0.06em;
  white-space: nowrap;
}

.gesture-divider {
  width: 1px;
  height: 28px;
  background: var(--line);
}

.fist-icon i {
  position: absolute;
  z-index: 2;
  top: 14px;
  width: 6px;
  height: 12px;
  border: 1px solid rgba(255, 177, 158, 0.75);
  border-radius: 4px;
  background: #0b1214;
}

.fist-icon i:nth-child(1) {
  left: 10px;
  height: 11px;
}

.fist-icon i:nth-child(2) {
  left: 16px;
  height: 14px;
}

.fist-icon i:nth-child(3) {
  left: 22px;
  height: 13px;
}

.fist-icon i:nth-child(4) {
  left: 28px;
  height: 10px;
}

.fist-icon::after {
  position: absolute;
  z-index: 1;
  bottom: 9px;
  left: 10px;
  width: 24px;
  height: 13px;
  content: "";
  border: 1px solid rgba(255, 177, 158, 0.75);
  border-radius: 3px 3px 8px 8px;
}

.palm-icon i {
  position: absolute;
  bottom: 12px;
  width: 4px;
  border: 1px solid rgba(255, 208, 188, 0.78);
  border-radius: 3px 3px 1px 1px;
  transform-origin: bottom center;
}

.palm-icon i:nth-child(1) {
  left: 9px;
  height: 13px;
  transform: rotate(-35deg);
}

.palm-icon i:nth-child(2) {
  left: 14px;
  height: 19px;
  transform: rotate(-10deg);
}

.palm-icon i:nth-child(3) {
  left: 20px;
  height: 22px;
}

.palm-icon i:nth-child(4) {
  left: 26px;
  height: 18px;
  transform: rotate(9deg);
}

.palm-icon i:nth-child(5) {
  left: 31px;
  height: 13px;
  transform: rotate(26deg);
}

.palm-icon::after {
  position: absolute;
  bottom: 9px;
  left: 12px;
  width: 20px;
  height: 12px;
  content: "";
  border: 1px solid rgba(255, 208, 188, 0.78);
  border-radius: 4px 4px 8px 8px;
}

.hero-actions {
  display: flex;
  gap: 20px;
  align-items: center;
  margin-top: 32px;
}

.camera-button {
  position: relative;
  display: inline-flex;
  gap: 12px;
  align-items: center;
  min-width: 166px;
  height: 49px;
  padding: 0 15px 0 18px;
  overflow: hidden;
  border: 1px solid rgba(255, 165, 143, 0.42);
  border-radius: 100px;
  background:
    linear-gradient(103deg, rgba(255, 117, 91, 0.18), rgba(255, 91, 132, 0.08)),
    rgba(16, 19, 22, 0.6);
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.07),
    0 12px 38px rgba(0, 0, 0, 0.18);
  cursor: pointer;
  transition:
    border-color 0.35s ease,
    background 0.35s ease,
    transform 0.35s var(--ease-out),
    opacity 0.35s ease;
  backdrop-filter: blur(18px);
}

.camera-button::before {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(110deg, transparent 15%, rgba(255, 255, 255, 0.1) 42%, transparent 65%);
  transform: translateX(-130%);
  transition: transform 0.75s var(--ease-out);
}

.camera-button:hover {
  border-color: rgba(255, 178, 158, 0.72);
  background:
    linear-gradient(103deg, rgba(255, 117, 91, 0.28), rgba(255, 91, 132, 0.13)),
    rgba(16, 19, 22, 0.68);
  transform: translateY(-2px);
}

.camera-button:hover::before {
  transform: translateX(130%);
}

.camera-button:focus-visible {
  outline: 2px solid rgba(255, 154, 133, 0.8);
  outline-offset: 4px;
}

.camera-button[aria-busy="true"] {
  cursor: wait;
  opacity: 0.7;
}

.camera-button.is-active {
  border-color: rgba(153, 225, 198, 0.23);
  background: rgba(14, 24, 22, 0.56);
}

.button-icon {
  display: grid;
  width: 25px;
  height: 25px;
  border: 1px solid rgba(255, 186, 171, 0.28);
  border-radius: 50%;
  place-items: center;
}

.button-icon svg {
  width: 13px;
  stroke: #ffb8a7;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 1.2;
}

#cameraButtonText {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.13em;
  white-space: nowrap;
}

.button-arrow {
  margin-left: auto;
  color: rgba(255, 203, 188, 0.68);
  font-family: var(--serif);
  font-size: 15px;
  transition: transform 0.3s ease;
}

.camera-button:hover .button-arrow {
  transform: translate(2px, -2px);
}

.privacy-note {
  display: flex;
  gap: 7px;
  align-items: center;
  margin: 0;
  color: rgba(212, 203, 195, 0.37);
  font-size: 8px;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.privacy-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(153, 225, 198, 0.52);
}

.gesture-telemetry {
  position: absolute;
  top: clamp(34px, 7.5vh, 78px);
  right: clamp(28px, 5vw, 78px);
  width: 174px;
  padding: 15px 16px 13px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(8, 12, 15, 0.38);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
  pointer-events: none;
  animation: ui-enter 1.1s 0.7s var(--ease-out) both;
  backdrop-filter: blur(14px);
}

.gesture-telemetry::before,
.gesture-telemetry::after {
  position: absolute;
  width: 10px;
  height: 10px;
  content: "";
  pointer-events: none;
}

.gesture-telemetry::before {
  top: -1px;
  left: -1px;
  border-top: 1px solid rgba(255, 166, 145, 0.66);
  border-left: 1px solid rgba(255, 166, 145, 0.66);
}

.gesture-telemetry::after {
  right: -1px;
  bottom: -1px;
  border-right: 1px solid rgba(255, 166, 145, 0.66);
  border-bottom: 1px solid rgba(255, 166, 145, 0.66);
}

.telemetry-head {
  display: flex;
  justify-content: space-between;
  color: rgba(224, 215, 207, 0.4);
  font-size: 7px;
  letter-spacing: 0.15em;
}

.telemetry-index {
  color: rgba(255, 176, 158, 0.45);
}

.telemetry-reading {
  display: flex;
  gap: 3px;
  align-items: baseline;
  margin-top: 10px;
  color: #f1e6dc;
  font-family: var(--serif);
  font-variant-numeric: tabular-nums;
}

.telemetry-reading strong {
  font-size: 38px;
  font-weight: 400;
  letter-spacing: -0.05em;
  line-height: 1;
}

.telemetry-reading span {
  color: rgba(244, 224, 212, 0.48);
  font-size: 11px;
}

.telemetry-state {
  margin: 8px 0 10px;
  color: rgba(255, 182, 160, 0.64);
  font-size: 8px;
  letter-spacing: 0.22em;
}

.signal-track {
  position: relative;
  height: 1px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.signal-track span {
  display: block;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, #ff916f, #ff6e91, #cde7ca);
  box-shadow: 0 0 8px rgba(255, 121, 113, 0.6);
  transform: scaleX(var(--bloom));
  transform-origin: left center;
  transition: transform 0.14s linear;
}

.signal-ticks {
  display: flex;
  justify-content: space-between;
  padding-top: 5px;
}

.signal-ticks i {
  width: 1px;
  height: 3px;
  background: rgba(255, 255, 255, 0.12);
}

.camera-panel {
  position: absolute;
  z-index: 16;
  right: clamp(28px, 5vw, 78px);
  bottom: clamp(30px, 6.5vh, 64px);
  width: clamp(230px, 18vw, 276px);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(8, 12, 14, 0.64);
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
  animation: ui-enter 1.2s 0.85s var(--ease-out) both;
  backdrop-filter: blur(16px);
}

.camera-head,
.camera-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 27px;
  padding: 0 9px;
  color: rgba(221, 213, 205, 0.38);
  font-size: 6.5px;
  letter-spacing: 0.16em;
}

.camera-head span:first-child {
  display: flex;
  gap: 6px;
  align-items: center;
}

.camera-head i {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.26);
}

.camera-panel.is-active .camera-head i {
  background: var(--coral);
  box-shadow: 0 0 7px var(--coral);
}

.camera-view {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background:
    linear-gradient(rgba(151, 196, 186, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(151, 196, 186, 0.035) 1px, transparent 1px),
    #081010;
  background-size: 23px 23px;
}

#cameraVideo,
#landmarkCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scaleX(-1);
}

#cameraVideo {
  opacity: 0;
  filter: saturate(0.68) contrast(1.1) brightness(0.72);
  transition: opacity 0.7s ease;
}

#landmarkCanvas {
  z-index: 2;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.camera-panel.is-active #cameraVideo {
  opacity: 1;
}

.camera-panel.is-active #landmarkCanvas {
  opacity: 1;
}

.camera-panel.is-active .camera-standby {
  opacity: 0;
}

.camera-standby {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  justify-content: center;
  color: rgba(218, 209, 201, 0.28);
  font-size: 7px;
  letter-spacing: 0.16em;
  transition: opacity 0.5s ease;
}

.standby-scan {
  position: relative;
  width: 39px;
  height: 39px;
  border: 1px solid rgba(153, 225, 198, 0.16);
  border-radius: 50%;
}

.standby-scan::before,
.standby-scan::after {
  position: absolute;
  top: 50%;
  left: 50%;
  content: "";
  background: rgba(153, 225, 198, 0.2);
  transform: translate(-50%, -50%);
}

.standby-scan::before {
  width: 1px;
  height: 25px;
}

.standby-scan::after {
  width: 25px;
  height: 1px;
}

.view-corner {
  position: absolute;
  z-index: 3;
  width: 8px;
  height: 8px;
  pointer-events: none;
}

.corner-tl {
  top: 7px;
  left: 7px;
  border-top: 1px solid rgba(255, 198, 184, 0.55);
  border-left: 1px solid rgba(255, 198, 184, 0.55);
}

.corner-tr {
  top: 7px;
  right: 7px;
  border-top: 1px solid rgba(255, 198, 184, 0.55);
  border-right: 1px solid rgba(255, 198, 184, 0.55);
}

.corner-bl {
  bottom: 7px;
  left: 7px;
  border-bottom: 1px solid rgba(255, 198, 184, 0.55);
  border-left: 1px solid rgba(255, 198, 184, 0.55);
}

.corner-br {
  right: 7px;
  bottom: 7px;
  border-right: 1px solid rgba(255, 198, 184, 0.55);
  border-bottom: 1px solid rgba(255, 198, 184, 0.55);
}

.camera-foot {
  height: 24px;
  color: rgba(218, 210, 201, 0.38);
}

.camera-panel.is-tracking .camera-foot span:first-child {
  color: rgba(178, 232, 211, 0.78);
}

.side-note {
  position: absolute;
  z-index: 12;
  top: 50%;
  right: clamp(14px, 1.6vw, 28px);
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  color: rgba(220, 210, 201, 0.26);
  font-family: var(--serif);
  font-size: 7px;
  letter-spacing: 0.24em;
  transform: translateY(-50%) rotate(90deg);
  transform-origin: center;
  pointer-events: none;
}

.side-note i {
  width: 32px;
  height: 1px;
  background: rgba(255, 255, 255, 0.12);
}

.orientation-note {
  position: absolute;
  z-index: 11;
  bottom: 26px;
  left: clamp(28px, 7.3vw, 112px);
  color: rgba(214, 205, 196, 0.25);
  font-size: 7px;
  letter-spacing: 0.14em;
  pointer-events: none;
  animation: ui-enter 1.1s 1s var(--ease-out) both;
}

.toast {
  position: absolute;
  z-index: 40;
  bottom: 34px;
  left: 50%;
  max-width: min(430px, calc(100vw - 40px));
  padding: 11px 18px;
  border: 1px solid rgba(255, 181, 158, 0.18);
  border-radius: 100px;
  background: rgba(9, 13, 15, 0.84);
  color: rgba(242, 229, 218, 0.74);
  font-size: 10px;
  letter-spacing: 0.05em;
  line-height: 1.5;
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 12px);
  transition:
    opacity 0.35s ease,
    transform 0.35s var(--ease-out);
  backdrop-filter: blur(15px);
}

.toast.is-visible {
  opacity: 1;
  transform: translate(-50%, 0);
}

.boot-screen {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 50%, rgba(92, 38, 46, 0.16), transparent 30%),
    #06090c;
  transition:
    opacity 1.1s 0.2s ease,
    visibility 0s 1.3s linear;
}

.boot-screen.is-hidden {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.boot-flower {
  position: relative;
  width: 72px;
  height: 72px;
  animation: boot-turn 14s linear infinite;
}

.boot-flower i {
  position: absolute;
  top: 8px;
  left: 29px;
  width: 15px;
  height: 31px;
  border: 1px solid rgba(255, 142, 122, 0.65);
  border-radius: 100% 0 100% 0;
  transform-origin: 50% 28px;
  box-shadow: inset 0 0 12px rgba(255, 106, 103, 0.08);
}

.boot-flower i:nth-child(1) {
  transform: rotate(0);
}

.boot-flower i:nth-child(2) {
  transform: rotate(72deg);
}

.boot-flower i:nth-child(3) {
  transform: rotate(144deg);
}

.boot-flower i:nth-child(4) {
  transform: rotate(216deg);
}

.boot-flower i:nth-child(5) {
  transform: rotate(288deg);
}

.boot-flower b {
  position: absolute;
  top: 31px;
  left: 31px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #ff8f77;
  box-shadow: 0 0 22px 4px rgba(255, 112, 99, 0.44);
}

.boot-screen p {
  margin: 0;
  color: rgba(226, 215, 205, 0.46);
  font-family: var(--serif);
  font-size: 11px;
  letter-spacing: 0.25em;
}

.boot-line {
  width: 100px;
  height: 1px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.07);
}

.boot-line i {
  display: block;
  width: 45%;
  height: 100%;
  background: linear-gradient(90deg, transparent, #ff9179, transparent);
  animation: boot-loading 1.5s ease-in-out infinite;
}

@keyframes ui-enter {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes atmosphere-drift {
  from {
    transform: translate3d(-1%, -1%, 0) scale(1);
  }
  to {
    transform: translate3d(2%, 1.5%, 0) scale(1.04);
  }
}

@keyframes status-pulse {
  50% {
    opacity: 0.55;
    box-shadow: 0 0 0 6px rgba(153, 225, 198, 0.025), 0 0 18px rgba(153, 225, 198, 0.9);
  }
}

@keyframes boot-turn {
  to {
    transform: rotate(360deg);
  }
}

@keyframes boot-loading {
  from {
    transform: translateX(-110%);
  }
  to {
    transform: translateX(230%);
  }
}

@media (max-width: 1120px) {
  .hero {
    left: 5vw;
    width: min(440px, 41vw);
  }

  .hero h1 {
    font-size: clamp(54px, 6vw, 74px);
  }

  .coordinate {
    display: none;
  }

  .camera-panel {
    right: 5vw;
  }

  .gesture-telemetry {
    right: 5vw;
  }

  .orientation-note {
    left: 5vw;
  }
}

@media (max-width: 800px) {
  .app-shell {
    min-height: 520px;
  }

  .topbar {
    padding: 20px 22px;
  }

  .brand-copy small {
    display: none;
  }

  .brand-mark {
    width: 25px;
    height: 25px;
    transform: scale(0.83) rotate(10deg);
    transform-origin: left center;
  }

  .brand-copy strong {
    font-size: 17px;
  }

  .topbar-meta {
    gap: 18px;
  }

  .live-status {
    font-size: 8px;
  }

  .interface {
    height: calc(100% - 74px);
  }

  .hero {
    top: 12px;
    left: 22px;
    width: calc(100% - 44px);
    transform: none;
  }

  .eyebrow {
    margin-bottom: 20px;
    font-size: 8px;
  }

  .hero h1 {
    width: 94%;
    max-width: 560px;
    font-size: clamp(47px, 11vw, 68px);
  }

  .hero h1 em::after {
    right: -16px;
    bottom: 7px;
    width: 5px;
    height: 5px;
  }

  .lede {
    width: min(370px, 82%);
    margin-top: 18px;
    font-size: 12px;
    line-height: 1.75;
  }

  .gesture-guide {
    margin-top: 20px;
  }

  .gesture-divider {
    display: none;
  }

  .gesture-item small {
    display: none;
  }

  .gesture-icon {
    width: 35px;
    height: 35px;
    transform: scale(0.84);
  }

  .hero-actions {
    margin-top: 20px;
  }

  .camera-button {
    min-width: 146px;
    height: 43px;
    padding-left: 14px;
  }

  .privacy-note {
    display: none;
  }

  .gesture-telemetry {
    display: none;
  }

  .camera-panel {
    right: 18px;
    bottom: 21px;
    width: clamp(128px, 29vw, 184px);
  }

  .camera-head,
  .camera-foot {
    height: 22px;
    padding: 0 7px;
    font-size: 5.5px;
  }

  .camera-foot {
    height: 20px;
  }

  .side-note,
  .orientation-note {
    display: none;
  }
}

@media (max-width: 520px) {
  .hero h1 {
    font-size: clamp(43px, 12.4vw, 60px);
  }

  .lede {
    width: 93%;
  }

  .gesture-guide {
    gap: 13px;
  }

  .gesture-item {
    gap: 7px;
  }

  .gesture-item b {
    font-size: 8px;
  }

  .camera-panel {
    width: 124px;
    right: 14px;
    bottom: 15px;
  }

  .camera-head span:last-child,
  .camera-foot span:last-child {
    display: none;
  }

  .toast {
    bottom: 128px;
    font-size: 9px;
  }
}

@media (max-height: 690px) and (min-width: 801px) {
  .topbar {
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .interface {
    height: calc(100% - 71px);
  }

  .eyebrow {
    margin-bottom: 18px;
  }

  .hero h1 {
    font-size: clamp(50px, 5vw, 70px);
  }

  .lede {
    margin-top: 17px;
    line-height: 1.7;
  }

  .gesture-guide,
  .hero-actions {
    margin-top: 20px;
  }

  .camera-panel {
    width: 218px;
  }

  .gesture-telemetry {
    top: 28px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}
