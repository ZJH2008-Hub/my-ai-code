import * as THREE from "three";

const TAU = Math.PI * 2;
const clamp = (value, min = 0, max = 1) =>
  Math.min(max, Math.max(min, value));

function createRandom(seed = 20261027) {
  let state = seed >>> 0;
  return () => {
    state += 0x6d2b79f5;
    let value = state;
    value = Math.imul(value ^ (value >>> 15), value | 1);
    value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
  };
}

function makeGlowTexture() {
  const canvas = document.createElement("canvas");
  canvas.width = 256;
  canvas.height = 256;
  const context = canvas.getContext("2d");
  const gradient = context.createRadialGradient(128, 128, 0, 128, 128, 128);
  gradient.addColorStop(0, "rgba(255, 240, 212, 1)");
  gradient.addColorStop(0.08, "rgba(255, 205, 166, 0.92)");
  gradient.addColorStop(0.26, "rgba(255, 112, 107, 0.38)");
  gradient.addColorStop(0.58, "rgba(178, 48, 100, 0.1)");
  gradient.addColorStop(1, "rgba(80, 20, 54, 0)");
  context.fillStyle = gradient;
  context.fillRect(0, 0, 256, 256);

  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.minFilter = THREE.LinearFilter;
  texture.magFilter = THREE.LinearFilter;
  return texture;
}

function buildPetalGeometry(quality, random) {
  const density = quality === "low" ? 0.58 : 1;
  const layers = [
    {
      petals: 11,
      perPetal: Math.round(660 * density),
      base: 0.16,
      length: [1.44, 2.08],
      width: [0.62, 0.93],
      depth: -0.22,
      angleOffset: 0.08,
      palette: ["#d94276", "#ff6c6d", "#ffbd8d"],
      delay: 0.74,
      size: [0.42, 1.28],
    },
    {
      petals: 9,
      perPetal: Math.round(540 * density),
      base: 0.12,
      length: [0.92, 1.43],
      width: [0.43, 0.68],
      depth: 0.16,
      angleOffset: 0.34,
      palette: ["#ff4f88", "#ff8b82", "#ffd2a3"],
      delay: 0.48,
      size: [0.4, 1.1],
    },
    {
      petals: 7,
      perPetal: Math.round(410 * density),
      base: 0.07,
      length: [0.48, 0.87],
      width: [0.27, 0.5],
      depth: 0.39,
      angleOffset: 0.7,
      palette: ["#ff6c93", "#ffa386", "#ffe1b1"],
      delay: 0.26,
      size: [0.36, 0.98],
    },
  ];

  const totalParticles = layers.reduce(
    (total, layer) => total + layer.petals * layer.perPetal,
    0,
  );
  const positions = new Float32Array(totalParticles * 3);
  const budPositions = new Float32Array(totalParticles * 3);
  const colors = new Float32Array(totalParticles * 3);
  const sizes = new Float32Array(totalParticles);
  const phases = new Float32Array(totalParticles);
  const delays = new Float32Array(totalParticles);
  const color = new THREE.Color();
  let cursor = 0;

  layers.forEach((layer, layerIndex) => {
    const colorStops = layer.palette.map((value) => new THREE.Color(value));

    for (let petal = 0; petal < layer.petals; petal += 1) {
      const angle =
        (petal / layer.petals) * TAU +
        layer.angleOffset +
        (layerIndex % 2) * 0.07;
      const petalLength = THREE.MathUtils.lerp(
        layer.length[0],
        layer.length[1],
        random(),
      );
      const petalWidth = THREE.MathUtils.lerp(
        layer.width[0],
        layer.width[1],
        random(),
      );
      const petalTilt = (random() - 0.5) * 0.16;

      for (let index = 0; index < layer.perPetal; index += 1) {
        const t = Math.pow(random(), 0.9);
        const edge = random() * 2 - 1;
        const edgeSquared = edge * edge;
        const profile = Math.pow(
          Math.sin(Math.PI * clamp(t * 0.92 + 0.035)),
          0.68,
        );
        const radial = layer.base + t * petalLength;
        const tangent = edge * petalWidth * profile * (0.82 + random() * 0.18);
        const pointAngle = angle + petalTilt + (t - 0.5) * edge * 0.08;
        const radialX = Math.cos(pointAngle);
        const radialY = Math.sin(pointAngle);
        const tangentialX = -radialY;
        const tangentialY = radialX;
        const petalCup =
          Math.sin(Math.PI * t) * (0.075 + edgeSquared * 0.29);
        const jitter = 0.012;

        const positionIndex = cursor * 3;
        positions[positionIndex] =
          radialX * radial +
          tangentialX * tangent +
          (random() - 0.5) * jitter;
        positions[positionIndex + 1] =
          radialY * radial +
          tangentialY * tangent +
          (random() - 0.5) * jitter;
        positions[positionIndex + 2] =
          layer.depth -
          t * 0.1 +
          petalCup +
          (random() - 0.5) * jitter;

        const foldedAngle =
          angle +
          edge * (0.72 + t * 0.3) +
          t * 2.35 +
          layerIndex * 0.19;
        const budRadius =
          (0.075 +
            0.245 *
              Math.sin(Math.PI * clamp(0.12 + t * 0.8)) *
              (0.72 + edgeSquared * 0.3)) *
          (layerIndex === 0 ? 1 : 0.92);
        budPositions[positionIndex] =
          Math.cos(foldedAngle) * budRadius + (random() - 0.5) * 0.018;
        budPositions[positionIndex + 1] =
          (t - 0.47) * 1.18 +
          Math.cos(foldedAngle) * 0.055 +
          (random() - 0.5) * 0.018;
        budPositions[positionIndex + 2] =
          Math.sin(foldedAngle) * budRadius * 0.72 +
          0.035 +
          (random() - 0.5) * 0.015;

        const colorPosition =
          t * 0.72 + edgeSquared * 0.12 + layerIndex * -0.13;
        if (colorPosition < 0.58) {
          color.copy(colorStops[0]).lerp(colorStops[1], colorPosition / 0.58);
        } else {
          color
            .copy(colorStops[1])
            .lerp(colorStops[2], (colorPosition - 0.58) / 0.42);
        }
        color.offsetHSL(
          (random() - 0.5) * 0.025,
          (random() - 0.5) * 0.08,
          (random() - 0.5) * 0.08,
        );
        colors[positionIndex] = color.r;
        colors[positionIndex + 1] = color.g;
        colors[positionIndex + 2] = color.b;

        const isSpark = random() > 0.965;
        sizes[cursor] = isSpark
          ? 1.35 + random() * 1.1
          : THREE.MathUtils.lerp(layer.size[0], layer.size[1], random());
        phases[cursor] = random();
        delays[cursor] =
          layer.delay * 0.17 + (petal / layer.petals) * 0.045;
        cursor += 1;
      }
    }
  });

  return {
    positions,
    budPositions,
    colors,
    sizes,
    phases,
    delays,
    count: totalParticles,
  };
}

function appendCoreParticles(
  particles,
  quality,
  random,
) {
  const coreCount = Math.round((quality === "low" ? 1150 : 2400));
  const filamentCount = Math.round((quality === "low" ? 340 : 760));
  const total = particles.count + coreCount + filamentCount;
  const positions = new Float32Array(total * 3);
  const budPositions = new Float32Array(total * 3);
  const colors = new Float32Array(total * 3);
  const sizes = new Float32Array(total);
  const phases = new Float32Array(total);
  const delays = new Float32Array(total);

  positions.set(particles.positions);
  budPositions.set(particles.budPositions);
  colors.set(particles.colors);
  sizes.set(particles.sizes);
  phases.set(particles.phases);
  delays.set(particles.delays);

  const color = new THREE.Color();
  const gold = new THREE.Color("#ffd18a");
  const coral = new THREE.Color("#ff775f");
  const ivory = new THREE.Color("#fff2cf");
  let cursor = particles.count;

  for (let index = 0; index < coreCount; index += 1) {
    const positionIndex = cursor * 3;
    const angle = random() * TAU;
    const radius = Math.pow(random(), 0.55) * 0.3;
    const vertical = (random() * 2 - 1) * 0.31 * Math.sqrt(1 - radius / 0.34);

    positions[positionIndex] = Math.cos(angle) * radius;
    positions[positionIndex + 1] = vertical;
    positions[positionIndex + 2] =
      0.48 + Math.sin(angle) * radius * 0.32 + random() * 0.08;
    budPositions[positionIndex] = Math.cos(angle) * radius * 0.42;
    budPositions[positionIndex + 1] = vertical * 0.63 + 0.04;
    budPositions[positionIndex + 2] = 0.13 + Math.sin(angle) * radius * 0.2;

    color
      .copy(coral)
      .lerp(gold, random() * 0.65)
      .lerp(ivory, Math.pow(random(), 4) * 0.7);
    colors[positionIndex] = color.r;
    colors[positionIndex + 1] = color.g;
    colors[positionIndex + 2] = color.b;

    sizes[cursor] = random() > 0.9 ? 1.5 + random() * 1.25 : 0.52 + random() * 0.8;
    phases[cursor] = random();
    delays[cursor] = 0.08;
    cursor += 1;
  }

  for (let index = 0; index < filamentCount; index += 1) {
    const positionIndex = cursor * 3;
    const angle = random() * TAU;
    const filament = 0.15 + Math.pow(random(), 0.65) * 0.42;
    const bend = (random() - 0.5) * 0.15 * filament;
    const x = Math.cos(angle) * filament;
    const y = Math.sin(angle) * filament;

    positions[positionIndex] = x + Math.cos(angle + Math.PI / 2) * bend;
    positions[positionIndex + 1] = y + Math.sin(angle + Math.PI / 2) * bend;
    positions[positionIndex + 2] = 0.6 + filament * 0.12 + random() * 0.08;
    budPositions[positionIndex] = x * 0.26;
    budPositions[positionIndex + 1] = y * 0.32 + 0.06;
    budPositions[positionIndex + 2] = 0.18 + random() * 0.035;

    color.copy(gold).lerp(ivory, random() * 0.8);
    colors[positionIndex] = color.r;
    colors[positionIndex + 1] = color.g;
    colors[positionIndex + 2] = color.b;
    sizes[cursor] = random() > 0.84 ? 1.25 + random() * 0.8 : 0.28 + random() * 0.45;
    phases[cursor] = random();
    delays[cursor] = 0.02;
    cursor += 1;
  }

  return {
    positions,
    budPositions,
    colors,
    sizes,
    phases,
    delays,
    count: total,
  };
}

function createBloomPoints(particles, uniforms) {
  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute(
    "position",
    new THREE.BufferAttribute(particles.positions, 3),
  );
  geometry.setAttribute(
    "aBudPosition",
    new THREE.BufferAttribute(particles.budPositions, 3),
  );
  geometry.setAttribute("aColor", new THREE.BufferAttribute(particles.colors, 3));
  geometry.setAttribute("aSize", new THREE.BufferAttribute(particles.sizes, 1));
  geometry.setAttribute("aPhase", new THREE.BufferAttribute(particles.phases, 1));
  geometry.setAttribute("aDelay", new THREE.BufferAttribute(particles.delays, 1));
  geometry.computeBoundingSphere();

  const material = new THREE.ShaderMaterial({
    uniforms,
    vertexShader: `
      uniform float uTime;
      uniform float uBloom;
      uniform float uHandActive;
      uniform float uPixelRatio;
      uniform vec3 uHand;

      attribute vec3 aBudPosition;
      attribute vec3 aColor;
      attribute float aSize;
      attribute float aPhase;
      attribute float aDelay;

      varying vec3 vColor;
      varying float vAlpha;
      varying float vHeat;

      mat2 rotate2d(float angle) {
        float sine = sin(angle);
        float cosine = cos(angle);
        return mat2(cosine, -sine, sine, cosine);
      }

      void main() {
        float delayedBloom = clamp(
          (uBloom - aDelay) / max(0.0001, 1.0 - aDelay),
          0.0,
          1.0
        );
        delayedBloom = delayedBloom * delayedBloom * (3.0 - 2.0 * delayedBloom);

        vec3 bloomPosition = position;
        bloomPosition.z +=
          sin(uTime * 0.7 + aPhase * 6.28318) * 0.012 * (0.3 + delayedBloom);
        bloomPosition.xy *= 1.0 +
          sin(uTime * 0.46 + aPhase * 8.0) * 0.007 * delayedBloom;

        vec3 flowerPosition = mix(aBudPosition, bloomPosition, delayedBloom);

        vec2 handDelta = flowerPosition.xy - uHand.xy;
        float handDistance = length(handDelta);
        float handField =
          exp(-handDistance * handDistance * 1.25) * uHandActive;
        float ripple = sin(handDistance * 8.5 - uTime * 2.7);
        vec2 handDirection = normalize(handDelta + vec2(0.0001));

        flowerPosition.xy += handDirection * ripple * handField * 0.058;
        flowerPosition.xy = mix(
          flowerPosition.xy,
          uHand.xy,
          handField * 0.012
        );
        flowerPosition.z +=
          (0.13 + 0.12 * ripple) * handField +
          sin(uTime * 0.95 + aPhase * 4.0) * 0.016;

        float swirl = handField * 0.11 * sin(handDistance * 5.0 - uTime);
        flowerPosition.xy = rotate2d(swirl) * flowerPosition.xy;

        vec4 modelViewPosition = modelViewMatrix * vec4(flowerPosition, 1.0);
        gl_Position = projectionMatrix * modelViewPosition;

        float perspectiveScale = 24.0 / max(1.0, -modelViewPosition.z);
        gl_PointSize =
          aSize *
          uPixelRatio *
          perspectiveScale *
          (1.0 + handField * 0.78) *
          (0.88 + delayedBloom * 0.2);

        float shimmer =
          0.78 +
          0.22 * sin(uTime * 1.6 + aPhase * 18.0 + delayedBloom * 4.0);
        vColor = aColor * (0.86 + delayedBloom * 0.2);
        vColor += vec3(0.24, 0.12, 0.07) * handField;
        vAlpha = shimmer * (0.7 + handField * 0.3);
        vHeat = handField;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      varying float vAlpha;
      varying float vHeat;

      void main() {
        vec2 point = gl_PointCoord - vec2(0.5);
        float distanceToCenter = length(point);
        if (distanceToCenter > 0.5) discard;

        float softDisc = smoothstep(0.5, 0.0, distanceToCenter);
        softDisc = pow(softDisc, 2.05);
        float core = smoothstep(0.12, 0.0, distanceToCenter);
        float crossGlint =
          smoothstep(0.48, 0.0, abs(point.x)) *
          smoothstep(0.5, 0.0, abs(point.y)) *
          smoothstep(0.07, 0.0, abs(point.x));

        vec3 color = vColor + vec3(0.34, 0.15, 0.05) * vHeat;
        color += vec3(0.22, 0.12, 0.07) * core;
        float alpha = softDisc * 0.76 + core * 0.4 + crossGlint * 0.08;
        gl_FragColor = vec4(color, alpha * vAlpha);
      }
    `,
    transparent: true,
    depthWrite: false,
    depthTest: true,
    blending: THREE.AdditiveBlending,
  });

  const points = new THREE.Points(geometry, material);
  points.frustumCulled = false;
  return points;
}

function createStarDust(quality, uniforms, random) {
  const count = quality === "low" ? 420 : 780;
  const positions = new Float32Array(count * 3);
  const colors = new Float32Array(count * 3);
  const radii = new Float32Array(count);
  const angles = new Float32Array(count);
  const speeds = new Float32Array(count);
  const sizes = new Float32Array(count);
  const phases = new Float32Array(count);
  const color = new THREE.Color();

  for (let index = 0; index < count; index += 1) {
    const positionIndex = index * 3;
    radii[index] = 1.25 + Math.pow(random(), 0.7) * 2.5;
    angles[index] = random() * TAU;
    speeds[index] = (random() > 0.5 ? 1 : -1) * (0.018 + random() * 0.036);
    phases[index] = random();
    sizes[index] = random() > 0.85 ? 0.75 + random() * 1.0 : 0.24 + random() * 0.52;

    color
      .set(random() > 0.22 ? "#c4e7db" : "#ffad96")
      .lerp(new THREE.Color("#fff0cf"), random() * 0.55)
      .multiplyScalar(0.55 + random() * 0.35);
    colors[positionIndex] = color.r;
    colors[positionIndex + 1] = color.g;
    colors[positionIndex + 2] = color.b;
  }

  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute("aColor", new THREE.BufferAttribute(colors, 3));
  geometry.setAttribute("aRadius", new THREE.BufferAttribute(radii, 1));
  geometry.setAttribute("aAngle", new THREE.BufferAttribute(angles, 1));
  geometry.setAttribute("aSpeed", new THREE.BufferAttribute(speeds, 1));
  geometry.setAttribute("aSize", new THREE.BufferAttribute(sizes, 1));
  geometry.setAttribute("aPhase", new THREE.BufferAttribute(phases, 1));

  const material = new THREE.ShaderMaterial({
    uniforms: {
      uTime: uniforms.uTime,
      uPixelRatio: uniforms.uPixelRatio,
    },
    vertexShader: `
      uniform float uTime;
      uniform float uPixelRatio;

      attribute vec3 aColor;
      attribute float aRadius;
      attribute float aAngle;
      attribute float aSpeed;
      attribute float aSize;
      attribute float aPhase;

      varying vec3 vColor;
      varying float vAlpha;

      void main() {
        float angle = aAngle + uTime * aSpeed;
        vec3 animatedPosition = vec3(
          cos(angle) * aRadius,
          sin(angle) * aRadius * 0.58,
          sin(angle * 1.7 + aPhase * 6.28) * 0.65 - 0.35
        );
        vec4 modelViewPosition = modelViewMatrix * vec4(animatedPosition, 1.0);
        gl_Position = projectionMatrix * modelViewPosition;
        gl_PointSize =
          aSize *
          uPixelRatio *
          (22.0 / max(1.0, -modelViewPosition.z));

        float twinkle = 0.3 + 0.7 * pow(
          0.5 + 0.5 * sin(uTime * 1.1 + aPhase * 17.0),
          3.0
        );
        vColor = aColor;
        vAlpha = twinkle;
      }
    `,
    fragmentShader: `
      varying vec3 vColor;
      varying float vAlpha;

      void main() {
        float distanceToCenter = length(gl_PointCoord - vec2(0.5));
        if (distanceToCenter > 0.5) discard;
        float glow = smoothstep(0.5, 0.0, distanceToCenter);
        glow = pow(glow, 2.3);
        gl_FragColor = vec4(vColor, glow * vAlpha * 0.55);
      }
    `,
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
  });

  const points = new THREE.Points(geometry, material);
  points.frustumCulled = false;
  return points;
}

function createOrbitLine(radius, opacity, color) {
  const points = [];
  const count = 180;
  for (let index = 0; index < count; index += 1) {
    const angle = (index / count) * TAU;
    points.push(
      new THREE.Vector3(
        Math.cos(angle) * radius,
        Math.sin(angle) * radius * 0.62,
        -0.35,
      ),
    );
  }

  const geometry = new THREE.BufferGeometry().setFromPoints(points);
  const material = new THREE.LineBasicMaterial({
    color,
    transparent: true,
    opacity,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
  });
  return new THREE.LineLoop(geometry, material);
}

function createHandCursor(glowTexture) {
  const group = new THREE.Group();
  group.visible = false;

  const ringMaterial = new THREE.MeshBasicMaterial({
    color: "#ffc2a8",
    transparent: true,
    opacity: 0.32,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
  });
  const innerRingMaterial = ringMaterial.clone();
  innerRingMaterial.opacity = 0.18;

  const ring = new THREE.Mesh(
    new THREE.RingGeometry(0.165, 0.168, 64),
    ringMaterial,
  );
  const innerRing = new THREE.Mesh(
    new THREE.RingGeometry(0.082, 0.084, 48),
    innerRingMaterial,
  );
  innerRing.scale.setScalar(0.85);

  const dot = new THREE.Sprite(
    new THREE.SpriteMaterial({
      map: glowTexture,
      color: "#ffd6b2",
      transparent: true,
      opacity: 0.52,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    }),
  );
  dot.scale.setScalar(0.42);

  group.add(ring, innerRing, dot);
  return { group, ring, innerRing, dot };
}

export class ParticleFlower {
  constructor({ quality = "high" } = {}) {
    this.random = createRandom();
    this.quality = quality;
    this.group = new THREE.Group();
    this.group.name = "particle-flower";

    this.glowTexture = makeGlowTexture();
    this.uniforms = {
      uTime: { value: 0 },
      uBloom: { value: 0.78 },
      uPixelRatio: { value: 1 },
      uHand: { value: new THREE.Vector3(20, 20, 0) },
      uHandActive: { value: 0 },
    };

    const petals = buildPetalGeometry(quality, this.random);
    const particles = appendCoreParticles(petals, quality, this.random);
    this.petalPoints = createBloomPoints(particles, this.uniforms);
    this.starDust = createStarDust(quality, this.uniforms, this.random);
    this.orbitOuter = createOrbitLine(2.74, 0.055, "#99d5c3");
    this.orbitInner = createOrbitLine(2.38, 0.045, "#ff9a81");

    this.halo = new THREE.Sprite(
      new THREE.SpriteMaterial({
        map: this.glowTexture,
        color: "#ff7a78",
        transparent: true,
        opacity: 0.21,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      }),
    );
    this.halo.position.z = -0.65;
    this.halo.scale.setScalar(7.2);

    this.coreGlow = new THREE.Sprite(
      new THREE.SpriteMaterial({
        map: this.glowTexture,
        color: "#ffd29d",
        transparent: true,
        opacity: 0.25,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      }),
    );
    this.coreGlow.position.z = 0.38;
    this.coreGlow.scale.setScalar(2.25);

    this.handCursor = createHandCursor(this.glowTexture);
    this.group.add(
      this.halo,
      this.orbitOuter,
      this.orbitInner,
      this.starDust,
      this.petalPoints,
      this.coreGlow,
    );
  }

  setHand(worldPosition, active) {
    this.uniforms.uHandActive.value = active ? 1 : 0;
    this.handCursor.group.visible = Boolean(active);

    if (!active || !worldPosition) {
      this.uniforms.uHand.value.set(20, 20, 0);
      return;
    }

    this.group.updateMatrixWorld();
    const localPosition = this.group.worldToLocal(worldPosition.clone());
    this.uniforms.uHand.value.copy(localPosition);
    this.handCursor.group.position.copy(worldPosition);
  }

  update({ time, bloom, pixelRatio }) {
    this.uniforms.uTime.value = time;
    this.uniforms.uBloom.value = bloom;
    this.uniforms.uPixelRatio.value = pixelRatio;

    this.halo.material.opacity = 0.1 + bloom * 0.17;
    this.coreGlow.material.opacity = 0.1 + bloom * 0.2;
    this.coreGlow.scale.setScalar(1.1 + bloom * 1.35);
    this.orbitOuter.rotation.z = time * 0.009;
    this.orbitInner.rotation.z = -time * 0.014;
    this.orbitOuter.material.opacity = 0.03 + bloom * 0.035;
    this.orbitInner.material.opacity = 0.025 + bloom * 0.025;

    if (this.handCursor.group.visible) {
      const pulse = 1 + Math.sin(time * 2.2) * 0.08;
      this.handCursor.ring.scale.setScalar(pulse);
      this.handCursor.innerRing.scale.setScalar(0.85 + Math.sin(time * 1.7 + 1) * 0.12);
      this.handCursor.ring.rotation.z = time * 0.34;
      this.handCursor.innerRing.rotation.z = -time * 0.45;
    }
  }
}
